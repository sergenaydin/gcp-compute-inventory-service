# Copy: cp .env.example .env — .env is never committed.

# GCP project ID (the ID, not the project name — e.g. opsitex-gcp-case-123456)
GCP_PROJECT_ID=

# ABSOLUTE path to the service account key file.
# This file is never added to the repo (see .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

PORT=8080

# Optional: origin(s) of a separately hosted UI allowed to call this API (comma-separated).
# Not needed for local development; the UI's dev server proxies /api.
CORS_ORIGIN=
