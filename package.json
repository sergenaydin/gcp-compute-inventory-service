{
  "name": "gcp-compute-inventory-service",
  "version": "1.0.0",
  "description": "A service that normalizes and serves a GCP Compute Engine VM inventory",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@google-cloud/compute": "^4.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}
